# Where the Python backend lives, for a HOSTED build.
#
# This is baked into the build, but only USED when the app is served from a
# different host (Netlify). Locally, and when the Python server serves the app
# itself, the code ignores this and calls /api directly — see resolveApiBase()
# in src/lib/api.ts. So one build works in all three places.

VITE_API_BASE=https://minerva-api-1nni.onrender.com
