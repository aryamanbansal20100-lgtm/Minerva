# Secrets. The .env file holds live Groq / Gemini / Firebase keys — publishing
# it means anyone can spend your quota, and GitHub's history keeps a copy for
# ever even if you delete the file later. Never commit it.
.env
.env.local
*.key
*.pem

# Student data. Per-user SQLite databases and uploaded documents: real notes
# belonging to real people. These live on the server, never in the repository.
data/
*.db
*.db-wal
*.db-shm

# Build output and dependencies — regenerated by the build, and huge.
node_modules/
web/dist/
web/node_modules/
dist/
build/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local scratch
*.log
tmp/
scratch/

# The project itself is the repo — a zip of it does not belong in git.
*.zip

# The project itself is the repo — a zip of it does not belong in git.
*.zip
