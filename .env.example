# ---------------------------------------------------------------------------
# JARVIS environment. Copy to .env . The .env file is gitignored and chmod 600.
# Nothing in here ever reaches the browser. The Python server holds every key.
# ---------------------------------------------------------------------------

# --- Demo switch. Read in exactly one file: agent/data.py -------------------
# 1 = invented fixtures, safe to screen-record. THIS IS THE DEFAULT.
# 0 = your actual folders, listed in EVIE_VAULTS below.
EVIE_DEMO=

# --- Your real folders. Only used when EVIE_DEMO=0. Read-only, always. ----
# Semicolon-separated on Windows, colon-separated elsewhere.
EVIE_VAULTS=

# --- The brain. First one with a key wins. All are free tiers. -------------
# Groq   -> https://console.groq.com/keys      (fast, ~1s, free)
GROQ_API_KEY=
GROQ_MODEL=

# Gemini -> https://aistudio.google.com/apikey (free, slower)
GEMINI_API_KEY=
GEMINI_MODEL=

# Ollama -> local, no key needed. Used if the two above are absent.
OLLAMA_URL=
OLLAMA_MODEL=

# --- Voice. ElevenLabs both directions. -------------------------------------
# https://elevenlabs.io/app/settings/api-keys
# Without this key: speech OUT is unavailable and the UI says so on screen.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Speech IN uses ElevenLabs Scribe when the key above is present, and falls
# back to Groq's free Whisper endpoint when it is not.
ELEVENLABS_STT_MODEL=
GROQ_STT_MODEL=

# --- Server ------------------------------------------------------------------
EVIE_HOST=
EVIE_PORT=
GROQ_MAP_MODEL=
OLLAMA_ENABLED=
EVIE_HOTKEY=
EVIE_CHUNK_MINUTES=
EVIE_VOICE=
EVIE_MAIL_USER=
EVIE_MAIL_PASSWORD=
EVIE_MAIL_LIMIT=
EVIE_FAST=
FIREBASE_API_KEY=
FIREBASE_PROJECT=
EVIE_REQUIRE_AUTH=
GROQ_SMALL_MODEL=

# Origins allowed to call this API from another host (hosted front end).
EVIE_ALLOWED_ORIGINS=

# Optional. A second brain for when Groq is having a bad day -- it returns 502
# often enough mid-lesson that a fallback is worth having, and losing a slice
# means that stretch of the class never gets written up.
# Free at build.nvidia.com: 40 requests a minute, no card required.
NVIDIA_API_KEY=
# Defaults to nvidia/nemotron-3.5-lightning. Only set this to pin a different one.
NVIDIA_MODEL=
