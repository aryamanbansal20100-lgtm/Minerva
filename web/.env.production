# Where the Python backend lives, for a HOSTED build.
#
# Leave this EMPTY while you run Evie on your own machine — the Python server
# serves the app and the API from the same address, so nothing needs setting.
#
# Fill it in only when you host the two halves separately: the static app on
# Netlify, and the Python backend on a host that can run a Python process
# (Render, Railway, Fly.io — Netlify cannot run Python).
#
# No quotes, no trailing slash. Example:
#   VITE_API_BASE=https://evie-api.onrender.com
#
# Then just run:  npm run build
# (no environment variable to type on the command line — Vite reads this file)

VITE_API_BASE=
